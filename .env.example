# PostgreSQL database used by the Rails app (schema is unchanged; Prisma only reads/writes rows).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/budget_tracker_development

# Auth0 tenant domain, including protocol and trailing slash (JWT issuer; JWKS at <domain>.well-known/jwks.json).
AUTH0_DOMAIN=https://your-tenant.au.auth0.com/

# Auth0 API identifier (JWT audience).
AUTH0_API_IDENTIFIER=https://your-api-identifier

# Optional, defaults to 3000.
PORT=3000
